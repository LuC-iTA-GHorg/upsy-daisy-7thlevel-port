/* Windows resources of upsy.exe and upsy_launcher.exe (windres, from build.bat): version
 * information, manifest and, if build.bat extracted it from TOPSY.EXE (lb7tool icon), the
 * original game's icon. The icon is not in the repository: it comes from the game disc. The
 * information does not present itself as a Disney or 7th Level product: this is an unofficial
 * port. */
#include <winver.h>
#include <winuser.h>

#ifndef UPSY_FILE
#define UPSY_FILE "upsy.exe"
#endif
#ifndef UPSY_DESC
#define UPSY_DESC "Upsy - unofficial SDL2 port of the 7th Level Runtime Player"
#endif

#ifdef UPSY_ICON
1 ICON "upsy.ico"
#endif

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "upsy.manifest"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     0, 5, 0, 0
PRODUCTVERSION  0, 5, 0, 0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
	BLOCK "StringFileInfo"
	BEGIN
		BLOCK "040904B0"
		BEGIN
			VALUE "CompanyName",      "LuC-iTA-GHorg (UPSY project, unofficial)"
			VALUE "FileDescription",  UPSY_DESC
			VALUE "FileVersion",      "0.5.0.0"
			VALUE "InternalName",     UPSY_FILE
			VALUE "OriginalFilename", UPSY_FILE
			VALUE "ProductName",      "UPSY - SDL2 port of Hot Shots: Upsy Daisy"
			VALUE "ProductVersion",   "0.5.0.0"
			VALUE "LegalCopyright",   "Port code: LuC-iTA-GHorg. The game and its data (.BIN) belong to their respective owners and are not included."
			VALUE "Comments",         "Unofficial port, not affiliated with Disney or 7th Level. Requires the original game files."
		END
	END
	BLOCK "VarFileInfo"
	BEGIN
		VALUE "Translation", 0x0409, 1200
	END
END
